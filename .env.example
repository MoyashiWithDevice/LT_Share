# --- Cloudflare D1 接続設定 ---
# wrangler d1 create 後に発行される値 + APIトークンを設定
# APIトークン作成: https://dash.cloudflare.com/profile/api-tokens
# 権限: Account / D1 / Edit
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_DATABASE_ID=your-d1-database-id
CLOUDFLARE_D1_API_TOKEN=your-api-token

# ローカル開発用 SQLite ファイル (D1環境変数が無い場合に使用)
LOCAL_DB_PATH=./dev.db

# --- Cloudflare R2 設定 (PDF実体) ---
# D1にはオブジェクトキー(pdf_key)のみ保存し、バイナリはR2に保管する
# 公開バケット運用 (推奨・簡単): R2_PUBLIC_BASE_URL を設定すれば署名不要で配信
# 例: https://pub-xxxx.r2.dev / https://slides.example.com
R2_BUCKET_NAME=lt-share-slides
R2_PUBLIC_BASE_URL=
# 非公開バケット運用: 以下を設定すると署名付きURLを発行 + アップロードAPIが有効化
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PRESIGN_EXPIRES=3600

# Flask
FLASK_PORT=5000

# --- 管理画面 認証設定 ---
# 管理画面 (/admin) にパスワード保護をかける場合は設定 (未設定時は保護なし・開発用)
# SECRET_KEY はセッション暗号化用。 本番ではランダムな長い文字列に変更すること
ADMIN_PASSWORD=change-me
SECRET_KEY=change-this-to-random-string
